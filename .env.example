# Elice ML API - fill only in a local, ignored .env file.
ELICE_MLAPI_BASE_URL=https://mlapi.run/<deployment-id>/v1
ELICE_MLAPI_API_KEY=
ELICE_MLAPI_MODEL=openai/gpt-4o-mini
ELICE_MLAPI_CHAT_PATH=/chat/completions

# OpenDART - fill only in a local, ignored .env file.
OPENDART_API_KEY=

# Local PostgreSQL/pgvector
POSTGRES_DB=samnik_fact_room
POSTGRES_USER=samnik
# Loopback-only M0 default; replace both values together for any wider deployment.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://samnik:change-me-local-only@127.0.0.1:5432/samnik_fact_room

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
RUNTIME_MODE=external
CHECKPOINTER_MODE=none

# Local embedding model used for pgvector queries
EMBEDDING_MODEL=intfloat/multilingual-e5-small
