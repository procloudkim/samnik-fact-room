{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samnik-fact-room.local/schema/snapshot-manifest.schema.json",
  "title": "Samnik Fact Room immutable OpenDART snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "dataset",
    "immutable",
    "provenance",
    "companies",
    "filings",
    "files",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical snapshot descriptor and file digests"
    },
    "dataset": { "const": "opendart-filing" },
    "immutable": { "const": true },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "acquisition_mode",
        "evidence_status",
        "acquired_at"
      ],
      "properties": {
        "source_system": { "const": "OpenDART" },
        "acquisition_mode": {
          "enum": ["LIVE_API", "SYNTHETIC_FIXTURE"]
        },
        "evidence_status": {
          "enum": ["OFFICIAL_API_VERIFIED", "SYNTHETIC_UNVERIFIED"]
        },
        "acquired_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": "string", "format": "date-time" },
        "value_verification_status": {
          "enum": ["UNVERIFIED", "OFFICIAL_DART_HTML_VERIFIED"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acquisition_mode": { "const": "SYNTHETIC_FIXTURE" }
            }
          },
          "then": {
            "properties": {
              "evidence_status": { "const": "SYNTHETIC_UNVERIFIED" }
            }
          }
        }
      ]
    },
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["corp_code", "corp_name", "stock_code"],
        "properties": {
          "corp_code": { "type": "string", "pattern": "^[0-9]{8}$" },
          "corp_name": { "type": "string", "minLength": 1 },
          "stock_code": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      }
    },
    "filings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corp_code",
          "rcept_no",
          "report_name",
          "business_year",
          "reprt_code",
          "fs_div",
          "period_start",
          "period_end",
          "source_url"
        ],
        "properties": {
          "corp_code": { "type": "string", "pattern": "^[0-9]{8}$" },
          "rcept_no": { "type": "string", "pattern": "^[0-9]{14}$" },
          "report_name": { "type": "string", "minLength": 1 },
          "business_year": { "type": "integer", "minimum": 1999, "maximum": 2100 },
          "reprt_code": { "enum": ["11011", "11013", "11012", "11014"] },
          "fs_div": { "const": "CFS" },
          "period_start": { "type": "string", "format": "date" },
          "period_end": { "type": "string", "format": "date" },
          "filing_date": { "type": "string", "format": "date" },
          "source_url": {
            "type": "string",
            "pattern": "^https://dart\\.fss\\.or\\.kr/"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "size_bytes", "origin"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(raw|normalized|fixture)/[A-Za-z0-9._/-]+$"
          },
          "media_type": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "origin": {
            "enum": ["OPENDART_API", "SYNTHETIC_LOCAL", "LOCAL_DERIVATION"]
          },
          "api_endpoint": {
            "enum": ["list.json", "fnlttSinglAcntAll.json", "document.xml"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "path": { "const": "normalized/source_chunks.json" }
              }
            },
            "then": {
              "properties": { "origin": { "const": "LOCAL_DERIVATION" } }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
